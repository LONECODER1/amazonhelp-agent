# Groq API Key (100% Free at https://console.groq.com)
GROQ_API_KEY="your_groq_api_key"

# Hugging Face Access Token (Optional fallback)
HF_TOKEN="your_hf_access_token"
HUGGINGFACEHUB_ACCESS_TOKEN="your_hf_access_token"


# Models (Groq models: llama-3.3-70b-versatile, qwen-2.5-32b, deepseek-r1-distill-llama-70b)
CHAT_MODEL="llama-3.3-70b-versatile"
JUDGE_MODEL="llama-3.3-70b-versatile"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# Qdrant Vector Database
USE_LOCAL_QDRANT=false
QDRANT_PATH="./qdrant_db"
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="amazon_support"
QDRANT_URL="https://your-cluster-id.region.aws.cloud.qdrant.io"
QDRANT_API_KEY="your_qdrant_api_key"

# LangGraph Memory & Checkpoints
SQLITE_PATH="./checkpoints/chat_checkpoints.db"
MAX_MESSAGES=10
MAX_TOKENS=3000

# App Environment
ENVIRONMENT="production"
LOG_LEVEL="INFO"

# LangSmith Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="your_langsmith_api_key"
LANGCHAIN_PROJECT="amazonhelp"