# Providing you access token to HuggingFace with 0.1$ credits (6-7 prompts worth) , see the readme.md for it to follow along if you don't want you put your access token
HUGGINGFACEHUB_ACCESS_TOKEN="your_access_token"
HF_TOKEN="your_access_token"

#---------------------------------------------------
LANGCHAIN_TRACING_V2=true   # These 5 variable are optional (only if you need to track the traces with langsmith)
LANGSMITH_TRACING=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="your_langsmith_api_key"
LANGCHAIN_PROJECT="amazonhelp"
#---------------------------------------------------

CHAT_MODEL="Qwen/Qwen3.8-27B"   
JUDGE_MODEL="deepseek-ai/DeepSeek-V4.1-Flash"   # To evaluate retriever results (LLM as Judge)
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# Keep them as it is, but before anything follow readme.md so that you can start qdrant locally using Docker
USE_LOCAL_QDRANT=false  
QDRANT_PATH="./qdrant_db"
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="amazon_support"

SQLITE_PATH="./checkpoints/chat_checkpoints.db"
MAX_MESSAGES=10
MAX_TOKENS=3000

ENVIRONMENT="production"
LOG_LEVEL="INFO"
